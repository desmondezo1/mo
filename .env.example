# Copy to .env and fill in. Without MUBIT_API_KEY the server runs a mock model,
# so you can test the whole flow offline.

# Mubit key (starts with mbt_): app.mubit.ai → Get started / Mubit keys.
MUBIT_API_KEY=

# Which provider Mubit forwards to: anthropic (Claude) or openai.
MUBIT_PROVIDER=anthropic

# Model ID, exactly as you'd send it to the provider. On the starter credit it must be
# a model the credit serves; if not, the error message lists the ones it does.
MUBIT_MODEL=claude-haiku-5-5

# Use the base URL your Mubit console's Connect page shows.
MUBIT_BASE_URL=https://api.mubit.ai

# Provider prices in USD per million tokens, for the ledger (default: the model's list price).
# PRICE_IN_PER_M=1
# PRICE_OUT_PER_M=5

# Adapter estimates until you have real Try models numbers.
# ADAPTER_COST_RATIO=0.05
# ADAPTER_LATENCY_MS=200

# PORT=8787

# ---- Hosted Mo (leave these unset for local mode: no sign-in, one user) ----
# Supabase project → Settings → API. The anon key is public by design; the JWT secret is not.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_JWT_SECRET=          # only for projects still on the legacy HS256 secret; new projects use signing keys (JWKS), fetched automatically
# SIGN_IN_METHODS=google,email
# ALLOWED_ORIGINS=chrome-extension://<your-extension-id>
# MONTHLY_DECISION_CAP=3000     # per user, resets on the 1st (UTC)
# DAILY_SPEND_CAP_USD=25        # whole service, pauses new work for the day when reached
# RATE_PER_MINUTE=120           # requests per user per minute

# ---- Mo's voice (Fish Audio) ----
# With a key, Mo talks back with a natural voice (Talk back in the panel's menu). Without one,
# it uses the best voice on the computer. The key stays on the server.
# FISH_API_KEY=
# FISH_VOICE_ID=1b1286fcf2f44d8ba1405e0b71abca22   # "Friendly Young Female"; any Fish Audio voice ID
# FISH_MODEL=s2.1-pro-free                          # s2.1-pro for production
# MO_VOICE=off                                       # turn the voice off on the server
